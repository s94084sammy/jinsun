# 金孫環境變數範本。複製成倉庫根目錄的 .env 與 data/.env。
# 不要把填好的檔提交到 git。不要使用 Gemini。不要填 API 金鑰當模型授權。

# 模型只推 Grok 或 ChatGPT／Codex 訂閱，裝置碼登入，不是 API 金鑰。不要 Gemini。
# 登入指令見 README。不要為了省改便宜檔。

TZ=Asia/Taipei
HERMES_UID=1000
HERMES_GID=1000

# LINE Messaging API（家人申請頻道後再填，沒填也能在容器內測技能與排程）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_ALLOWED_USERS=
LINE_HOME_CHANNEL=
LINE_PUBLIC_URL=https://example.example
# Cloudflare 具名隧道權杖，只給金孫隧道容器用。不要提交。
# JINSUN_TUNNEL_TOKEN=
LINE_ALLOW_ALL_USERS=false
LINE_HOST=0.0.0.0
LINE_PORT=8646
# LINE 免費額度：Reply 回覆不計月額，Push 推播才計。金孫預設關掉推播與連發。
LINE_ALLOW_PUSH=false
LINE_CRON_ALLOW_PUSH=false
LINE_MAX_MESSAGES_PER_CALL=1
LINE_SLOW_RESPONSE_THRESHOLD=40

# 閘道本機控制面用，容器第一次啟動會自行產生。不要公開。
# API_SERVER_KEY=

# 台灣在地查詢（自己去官方申請，不要抄別人的金鑰。沒填也能跑，只是該項會回白話說明）
# 中央氣象署開放資料授權碼：https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=
# 環境部環境資料開放平臺：長期介接空氣品質用。沒填會改走政府資料開放平臺目錄。
MOENV_API_KEY=
# 交通部 TDX。沒填就先不做公車捷運即時，不要卡住其他功能。
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
